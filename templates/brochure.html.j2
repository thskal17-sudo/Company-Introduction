<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.name }} 회사소개서</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --brand: {{ c.brand_color or '#1F4E79' }};
    --accent: {{ c.accent_color or '#F2A900' }};
    --ink: #1c2430;
    --muted: #5b6573;
    --line: #e3e7ec;
    --bg: #f5f7fa;
    --card: #ffffff;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: "Noto Sans KR", "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    color: var(--ink);
    background: #d9dee5;
    line-height: 1.6;
    word-break: keep-all;
    overflow-wrap: anywhere;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page {
    width: 210mm;
    min-height: 297mm;
    margin: 12mm auto;
    background: var(--card);
    padding: 18mm 18mm 16mm;
    position: relative;
    box-shadow: 0 4px 24px rgba(0,0,0,.12);
    page-break-after: always;
    break-after: page;
    display: flex;
    flex-direction: column;
  }
  .page:last-child { page-break-after: auto; break-after: auto; }
  .page-footer {
    margin-top: auto;
    padding-top: 8mm;
    display: flex;
    justify-content: space-between;
    font-size: 9pt;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
  h1, h2, h3, h4 { margin: 0; line-height: 1.3; font-weight: 700; }
  p { margin: 0 0 .8em; }
  p:last-child { margin-bottom: 0; }
  .section-title {
    font-size: 20pt;
    color: var(--brand);
    margin-bottom: 7mm;
    padding-bottom: 3mm;
    border-bottom: 3px solid var(--brand);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .section-title small {
    font-size: 9pt;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .lead { font-size: 11.5pt; color: var(--ink); }
  .muted { color: var(--muted); }

  /* ---- Cover ---- */
  .cover {
    background: linear-gradient(160deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 70%, black) 100%);
    color: #fff;
    padding: 24mm 20mm;
  }
  .cover .logo-box { height: 26mm; display: flex; align-items: center; }
  .cover .logo-box img { max-height: 26mm; max-width: 95mm; }
  .cover .logo-text { font-size: 16pt; font-weight: 900; letter-spacing: .04em; }
  .cover .cover-body { margin-top: auto; margin-bottom: auto; }
  .cover .doc-kind {
    display: inline-block;
    font-size: 10pt;
    letter-spacing: .3em;
    padding: 4px 14px;
    border: 1px solid rgba(255,255,255,.6);
    border-radius: 999px;
    margin-bottom: 10mm;
  }
  .cover h1 { font-size: 40pt; font-weight: 900; line-height: 1.15; }
  .cover .name-en { font-size: 12pt; opacity: .8; margin-top: 4mm; letter-spacing: .06em; }
  .cover .slogan { font-size: 16pt; font-weight: 300; margin-top: 12mm; }
  .cover .tagline { font-size: 10.5pt; opacity: .85; margin-top: 2mm; }
  .cover .accent-bar { width: 22mm; height: 5px; background: var(--accent); margin: 8mm 0; }
  .cover .cover-foot { display: flex; justify-content: space-between; font-size: 9.5pt; opacity: .9; }

  /* ---- Stats ---- */
  .stats { display: grid; grid-template-columns: repeat({{ stats|length if stats else 4 }}, 1fr); gap: 4mm; margin: 6mm 0; }
  .stat { background: var(--bg); border-radius: 8px; padding: 5mm 4mm; text-align: center; border-top: 4px solid var(--accent); }
  .stat .value { white-space: nowrap; font-size: 19pt; font-weight: 900; color: var(--brand); line-height: 1.1; }
  .stat .label { font-size: 9.5pt; color: var(--muted); margin-top: 2mm; }

  /* ---- Mission / vision ---- */
  .mv { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; margin-top: 2mm; }
  .mv .box { background: var(--brand); color: #fff; border-radius: 8px; padding: 5mm 6mm; }
  .mv .box.alt { background: color-mix(in srgb, var(--brand) 12%, white); color: var(--ink); }
  .mv .kicker { font-size: 9pt; letter-spacing: .2em; opacity: .8; margin-bottom: 2mm; }
  .mv .text { font-size: 12.5pt; font-weight: 500; line-height: 1.5; }

  /* ---- Greeting ---- */
  .greeting { background: var(--bg); border-left: 5px solid var(--accent); border-radius: 0 8px 8px 0; padding: 5mm 7mm; margin-bottom: 6mm; }
  .greeting .g-title { font-size: 9pt; letter-spacing: .2em; color: var(--muted); margin-bottom: 2mm; }
  .greeting p { font-size: 10.5pt; }
  .greeting .signer { text-align: right; font-weight: 700; margin-top: 3mm; color: var(--brand); }

  /* ---- Strategies ---- */
  .strategies { display: grid; grid-template-columns: repeat(auto-fit, minmax(30mm, 1fr)); gap: 4mm; margin-top: 2mm; }
  .strategy { text-align: center; }
  .strategy .circle { width: 30mm; height: 30mm; border-radius: 50%; margin: 0 auto 2mm; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 10pt; line-height: 1.25; padding: 2mm; word-break: keep-all; text-align: center; }
  .strategy:nth-child(even) .circle { background: var(--brand); }
  .strategy p { font-size: 9pt; color: var(--muted); }

  /* ---- Values ---- */
  .values { display: grid; grid-template-columns: repeat({{ 3 if values and values|length % 3 == 0 else 2 }}, 1fr); gap: 4mm; }
  .value { border: 1px solid var(--line); border-radius: 8px; padding: 4mm 5mm; }
  .value .num { font-size: 9pt; color: var(--accent); font-weight: 700; letter-spacing: .1em; }
  .value h3 { font-size: 12.5pt; color: var(--brand); margin: 1mm 0 2mm; }
  .value p { font-size: 10pt; color: var(--muted); }

  /* ---- History ---- */
  .timeline { list-style: none; margin: 0; padding: 0 0 0 6mm; border-left: 2px solid var(--line); }
  .timeline li { position: relative; padding: 0 0 4mm 8mm; }
  .timeline li::before {
    content: ""; position: absolute; left: -7.5mm; top: 2.2mm; width: 11px; height: 11px; border-radius: 50%;
    background: var(--accent); border: 2px solid #fff; box-shadow: 0 0 0 2px var(--accent);
  }
  .timeline .year { font-weight: 700; color: var(--brand); font-size: 12pt; }
  .timeline .event { font-size: 10.5pt; }

  /* ---- Programs ---- */
  .programs { display: grid; gap: 4mm; }
  .program { border: 1px solid var(--line); border-left: 6px solid var(--brand); border-radius: 8px; padding: 4mm 6mm; }
  .program h3 { font-size: 13pt; color: var(--brand); }
  .program .summary { font-size: 10.5pt; margin: 1mm 0 2mm; }
  .program .meta { display: flex; gap: 8mm; font-size: 9.5pt; color: var(--muted); margin-bottom: 2mm; flex-wrap: wrap; }
  .program .meta b { color: var(--ink); font-weight: 500; }
  .program ul { margin: 0; padding-left: 5mm; font-size: 10pt; }
  .program li { margin-bottom: 1mm; }

  /* ---- Comparison (무엇이 다른가) ---- */
  .cmp-quote { background: var(--brand); color: #fff; border-radius: 10px; padding: 9mm 10mm; font-size: 17pt; font-weight: 300; line-height: 1.5; position: relative; margin-bottom: 7mm; }
  .cmp-quote b { font-weight: 700; color: var(--accent); }
  .cmp-quote::before { content: "“"; position: absolute; top: -8mm; left: 6mm; font-size: 40pt; color: var(--accent); font-weight: 900; line-height: 1; }
  .cmp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 6mm; }
  .cmp-col h4 { font-size: 11.5pt; margin-bottom: 3mm; padding-bottom: 2mm; border-bottom: 2px solid var(--line); }
  .cmp-col.after h4 { border-color: var(--accent); color: var(--brand); }
  .cmp-col ul { list-style: none; margin: 0; padding: 0; }
  .cmp-col li { font-size: 10.5pt; padding: 1.2mm 0 1.2mm 7mm; position: relative; color: var(--muted); }
  .cmp-col li::before { content: "✕"; position: absolute; left: 0; color: #b6bcc5; font-weight: 700; }
  .cmp-col.after li { color: var(--ink); font-weight: 500; }
  .cmp-col.after li::before { content: "✔"; color: var(--accent); }
  .cmp-goal { margin-top: 7mm; background: var(--bg); border-radius: 8px; padding: 5mm; text-align: center; }
  .cmp-goal .k { font-size: 9pt; letter-spacing: .2em; color: var(--muted); }
  .cmp-goal .v { font-size: 14pt; font-weight: 700; margin-top: 1mm; }

  /* ---- Program axes (교육 3축) ---- */
  .axes { display: grid; gap: 4mm; }
  .axis { display: grid; grid-template-columns: 30mm 1fr; align-items: center; }
  .axis .lbl { height: 16mm; border-radius: 8mm 0 0 8mm; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 10.5pt; padding: 0 3mm; text-align: center; }
  .axis .txt { height: 16mm; border-radius: 0 8mm 8mm 0; background: var(--bg); display: flex; align-items: center; padding: 0 7mm; font-size: 11.5pt; }
  .axis .txt b { color: var(--accent); }
  .axes-note { text-align: center; font-size: 12.5pt; font-weight: 700; margin-top: 6mm; color: var(--brand); }

  /* ---- Program detail page ---- */
  .pd-target { display: inline-block; font-size: 9.5pt; color: var(--brand); background: color-mix(in srgb, var(--accent) 15%, white); border-left: 3px solid var(--accent); padding: 1.5mm 4mm; margin: -3mm 0 6mm; }
  .pd-intro { font-size: 13pt; font-weight: 500; line-height: 1.6; margin-bottom: 7mm; }
  .pd-intro b { color: var(--accent); }
  .pd-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(60mm, 1fr)); gap: 5mm 8mm; }
  /* 사진이 없을 때는 섹션을 카드로 만들어 지면을 채웁니다. */
  .pd-sections.spread { flex: 1; align-content: center; grid-auto-rows: min-content; gap: 6mm; }
  .pd-sections.spread .pd-section { background: var(--bg); border-radius: 8px; padding: 7mm 7mm 6mm; border-top: 3px solid var(--accent); }
  .pd-sections.spread h4 { font-size: 12.5pt; }
  .pd-sections.spread ul { font-size: 11pt; line-height: 1.8; padding-left: 5mm; }
  .pd-sections.spread .sub { font-size: 10pt; margin-bottom: 3mm; }
  .pd-section h4 { font-size: 11.5pt; color: var(--brand); margin-bottom: 2mm; }
  .pd-section h4 .n { color: var(--accent); margin-right: 1.5mm; }
  .pd-section ul { margin: 0; padding-left: 4.5mm; font-size: 10.5pt; }
  .pd-section li { margin-bottom: 1.2mm; }
  .pd-section .sub { font-size: 9.5pt; color: var(--muted); margin-bottom: 1.5mm; }
  .pd-photos { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: 3mm; margin-top: 7mm; }
  .pd-photos img { width: 100%; height: var(--ph-h, 42mm); object-fit: cover; border-radius: 6px; display: block; }
  .photo-slot { width: 100%; height: var(--ph-h, 42mm); border-radius: 6px; border: 1.5px dashed #c3c9d2; background: repeating-linear-gradient(45deg, #fafbfc, #fafbfc 6px, #f2f4f7 6px, #f2f4f7 12px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5mm; text-align: center; padding: 3mm; }
  .photo-slot .ps-icon { font-size: 15pt; color: #aeb5bf; line-height: 1; }
  .photo-slot .ps-label { font-size: 8.5pt; color: #8b939e; font-weight: 500; }
  .photo-slot .ps-file { font-size: 7.5pt; color: #aeb5bf; word-break: break-all; }
  .instructor .photo-slot { width: 42mm; height: 52mm; }

  /* ---- Strengths ---- */
  .strengths { display: grid; gap: 4mm; margin-top: 6mm; }
  .strength { display: grid; grid-template-columns: 12mm 1fr; gap: 4mm; align-items: start; }
  .strength .icon { width: 12mm; height: 12mm; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 900; display: flex; align-items: center; justify-content: center; font-size: 12pt; }
  .strength h3 { font-size: 12pt; }
  .strength p { font-size: 10pt; color: var(--muted); }

  /* ---- Instructors ---- */
  .instructor { display: grid; grid-template-columns: 42mm 1fr; gap: 8mm; padding: 6mm 0; border-bottom: 1px solid var(--line); page-break-inside: avoid; break-inside: avoid; }
  .instructor:last-of-type { border-bottom: none; }
  .instructor .photo { width: 42mm; height: 52mm; border-radius: 8px; object-fit: cover; background: var(--bg); display: block; }
  .instructor .avatar { width: 42mm; height: 52mm; border-radius: 8px; background: color-mix(in srgb, var(--brand) 18%, white); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 30pt; font-weight: 900; }
  .instructor h3 { font-size: 15pt; }
  .instructor .role { color: var(--brand); font-weight: 500; font-size: 10.5pt; margin-bottom: 2mm; }
  .instructor .quote { font-size: 10pt; color: var(--muted); font-style: normal; border-left: 3px solid var(--accent); padding-left: 3mm; margin: 2mm 0 3mm; }
  .instructor .bio { font-size: 10pt; }
  .tags { display: flex; flex-wrap: wrap; gap: 2mm; margin: 2mm 0 3mm; }
  .tag { font-size: 8.5pt; background: color-mix(in srgb, var(--brand) 10%, white); color: var(--brand); padding: 1px 8px; border-radius: 999px; font-weight: 500; }
  .instructor .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; margin-top: 2mm; }
  .instructor .cols h4 { font-size: 9pt; color: var(--muted); letter-spacing: .05em; margin-bottom: 1mm; }
  .instructor .cols ul { margin: 0; padding-left: 4mm; font-size: 9.5pt; }

  /* ---- Instructor grid (분야별 대표 강사) ---- */
  .ins-grid { display: grid; grid-template-columns: repeat(var(--ins-cols, 3), 1fr); gap: 3.5mm; }
  /* 카드가 적어 아래가 비면 세로 가운데쯤에 놓이도록 합니다. */
  .ins-grid.few { margin-top: auto; margin-bottom: auto; }
  .ins-card { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; page-break-inside: avoid; break-inside: avoid; }
  .ins-card .ph { width: 100%; height: var(--ins-ph, 32mm); object-fit: cover; display: block; }
  .ins-card .ph-slot { width: 100%; height: var(--ins-ph, 32mm); border-bottom: 1px solid var(--line); }
  .ins-card .ph-avatar { width: 100%; height: var(--ins-ph, 32mm); background: color-mix(in srgb, var(--brand) 12%, white); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 26pt; font-weight: 900; }
  .ins-card .body { padding: 3mm 3.5mm 3.5mm; display: flex; flex-direction: column; flex: 1; }
  .ins-card .field { display: inline-block; align-self: flex-start; font-size: 8.5pt; font-weight: 700; color: #fff; background: var(--accent); border-radius: 999px; padding: 0.8mm 3mm; margin-bottom: 2mm; }
  .ins-card .nm { font-size: 12pt; font-weight: 700; }
  .ins-card .nm .todo { color: #b8bec7; font-weight: 500; }
  .ins-card .rl { font-size: 9pt; color: var(--muted); margin-top: 0.3mm; }
  .ins-card .qt { font-size: 8.5pt; line-height: 1.45; color: var(--muted); border-left: 2px solid var(--accent); padding-left: 2.5mm; margin-top: 2mm; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ins-card .tg { display: flex; flex-wrap: wrap; gap: 1.2mm; margin-top: 2mm; }
  .ins-card .tg span { font-size: 8pt; background: color-mix(in srgb, var(--brand) 8%, white); color: var(--brand); border-radius: 999px; padding: 0.5mm 2.5mm; }
  .ins-card ul { margin: 1.5mm 0 0; padding-left: 3.5mm; font-size: 8.5pt; line-height: 1.45; color: var(--ink); }
  .ins-card ul li { margin-bottom: 0.6mm; }
  .ins-card h5 { font-size: 7.5pt; color: var(--muted); letter-spacing: .05em; margin: 2mm 0 0.3mm; font-weight: 500; }
  .ins-card .one-line { font-size: 8.5pt; line-height: 1.45; color: var(--ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1.5mm; }
  .ins-card .one-line.clamp1 { -webkit-line-clamp: 1; }
  .ins-card .one-line .lbl { color: var(--muted); font-size: 7.5pt; margin-right: 1.5mm; }

  /* ---- Instructor cards without photos ---- */
  .ins-grid.nophoto { grid-template-columns: repeat(2, 1fr); gap: 6mm; flex: 1; align-content: center; }
  .ins-grid.nophoto .ins-card { align-items: center; text-align: center; padding: 9mm 7mm; border-radius: 10px; }
  .ins-grid.nophoto .initial { width: 24mm; height: 24mm; border-radius: 50%; background: var(--accent); color: #fff; font-size: 17pt; font-weight: 900; display: flex; align-items: center; justify-content: center; margin-bottom: 5mm; }
  .ins-grid.nophoto .body { padding: 0; align-items: center; text-align: center; }
  .ins-grid.nophoto .field { align-self: center; font-size: 9pt; padding: 1mm 4mm; }
  .ins-grid.nophoto .nm { font-size: 17pt; margin-top: 1.5mm; }
  .ins-grid.nophoto .rl { font-size: 10.5pt; margin-top: 1mm; }
  .ins-grid.nophoto .qt { border-left: none; padding: 0; text-align: center; font-size: 9.5pt; margin-top: 3mm; }
  .ins-grid.nophoto .tg { justify-content: center; margin-top: 3mm; }
  .ins-grid.nophoto .one-line { text-align: center; }

  /* ---- Clients / testimonials ---- */
  .clients { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; }
  .client { background: var(--bg); border-radius: 6px; padding: 3mm; text-align: center; font-size: 10.5pt; font-weight: 500; }
  .testimonials { display: grid; grid-template-columns: repeat(auto-fit, minmax(70mm, 1fr)); gap: 4mm; margin-top: 6mm; }
  .testimonial { background: var(--bg); border-radius: 8px; padding: 4mm 5mm; }
  .testimonial .q { font-size: 10.5pt; }
  .testimonial .a { font-size: 9.5pt; color: var(--muted); margin-top: 2mm; }

  /* ---- Back cover (고객사·후기가 없을 때의 마지막 페이지) ---- */
  .page.backcover { background: linear-gradient(160deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 70%, black) 100%); color: #fff; justify-content: center; align-items: center; text-align: center; }
  .backcover img.bc-logo { max-height: 30mm; max-width: 100mm; margin-bottom: 10mm; }
  .backcover .bc-name { font-size: 15pt; font-weight: 700; letter-spacing: .02em; }
  .backcover h2 { font-size: 22pt; font-weight: 700; margin-top: 12mm; max-width: 150mm; }
  .backcover .bc-msg { font-size: 11.5pt; opacity: .85; margin-top: 4mm; max-width: 140mm; }
  .backcover .accent-bar { width: 22mm; height: 5px; background: var(--accent); margin: 9mm auto; }
  .backcover .bc-contact { display: flex; flex-wrap: wrap; justify-content: center; gap: 5mm 14mm; font-size: 10.5pt; margin-top: 2mm; }
  .backcover .bc-contact .k { font-size: 8.5pt; opacity: .65; letter-spacing: .05em; }
  .backcover .bc-contact .v { font-weight: 500; }
  .backcover .page-footer { position: absolute; left: 18mm; right: 18mm; bottom: 16mm; border-top-color: rgba(255,255,255,.25); color: rgba(255,255,255,.7); }

  /* ---- Closing ---- */
  .closing-block { margin-top: auto; padding-top: 10mm; }
  .closing-block + .page-footer { margin-top: 8mm; }
  .closing-logo { max-height: 16mm; max-width: 70mm; margin-top: 8mm; display: block; }
  .closing { background: var(--brand); color: #fff; border-radius: 10px; padding: 8mm 10mm; text-align: center; margin-top: 7mm; }
  .closing h2 { font-size: 18pt; }
  .closing p { font-size: 11pt; opacity: .9; margin-top: 3mm; }
  .contact { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3mm 8mm; margin-top: 6mm; font-size: 10pt; }
  .contact .k { font-size: 9pt; color: var(--muted); letter-spacing: .05em; }
  .contact .v { font-weight: 500; }

  @media print {
    body { background: #fff; }
    .page { margin: 0; box-shadow: none; width: 210mm; min-height: 297mm; }
  }
  @page { size: A4; margin: 0; }
</style>
</head>
<body>

{# 프로그램이 많으면 차별화 포인트는 마지막 페이지로 보내 A4 한 장을 넘지 않게 합니다. #}
{% set simple_programs = programs|rejectattr("sections")|list %}
{% set detail_programs = programs|selectattr("sections")|list %}
{% set strengths_on_last_page = strengths and simple_programs|length > 2 %}
{# 핵심 가치가 없으면 연혁을 회사 소개 페이지에 붙여 빈 페이지가 생기지 않게 합니다. #}
{% set history_on_about_page = history and not values and history|length <= 6 %}
{% macro history_block(history, before) %}
  <h2 class="section-title" {% if before %}style="margin-top:10mm"{% endif %}>연혁 <small>History</small></h2>
  <ul class="timeline">
    {% for h in history %}
    <li><div class="year">{{ h.year }}</div><div class="event">{{ h.event }}</div></li>
    {% endfor %}
  </ul>
{% endmacro %}
{# 통계·미션·비전이 없어 회사 소개 페이지가 비면 핵심 가치를 그 페이지에 함께 배치합니다. #}
{% set values_on_about_page = values and not stats and not mission and not vision and not history_on_about_page and values|length <= 4 %}
{% macro values_block(values, before) %}
  <h2 class="section-title" {% if before %}style="margin-top:8mm"{% endif %}>핵심 가치 <small>Core Values</small></h2>
  <div class="values">
    {% for v in values %}
    <div class="value">
      <div class="num">{{ '%02d' % loop.index }}{% if v.en %} · {{ v.en }}{% endif %}</div>
      <h3>{{ v.title }}</h3>
      <p>{{ v.description }}</p>
    </div>
    {% endfor %}
  </div>
{% endmacro %}
{% macro strategies_block(strategies) %}
  <h2 class="section-title" style="margin-top:8mm">전략 방향 <small>Strategic Direction</small></h2>
  <div class="strategies">
    {% for st in strategies %}
    <div class="strategy"><div class="circle">{{ st.title }}</div>{% if st.description %}<p>{{ st.description }}</p>{% endif %}</div>
    {% endfor %}
  </div>
{% endmacro %}
{% macro strengths_block(strengths, before) %}
  <h2 class="section-title" {% if before %}style="margin-top:10mm"{% endif %}>차별화 포인트 <small>Why Us</small></h2>
  <div class="strengths">
    {% for s in strengths %}
    <div class="strength">
      <div class="icon">{{ loop.index }}</div>
      <div><h3>{{ s.title }}</h3><p>{{ s.description }}</p></div>
    </div>
    {% endfor %}
  </div>
{% endmacro %}

{# ================= 표지 ================= #}
<section class="page cover">
  <div class="logo-box">
    {% if c.logo_white or c.logo %}<img src="{{ c.logo_white or c.logo }}" alt="{{ c.name }} 로고">{% else %}<span class="logo-text">{{ c.name }}</span>{% endif %}
  </div>
  <div class="cover-body">
    <span class="doc-kind">회사소개서</span>
    <h1>{{ c.name }}</h1>
    {% if c.name_en %}<div class="name-en">{{ c.name_en }}</div>{% endif %}
    <div class="accent-bar"></div>
    {% if c.slogan %}<div class="slogan">{{ c.slogan }}</div>{% endif %}
    {% if c.tagline %}<div class="tagline">{{ c.tagline }}</div>{% endif %}
  </div>
  <div class="cover-foot">
    <span>{{ c.website or c.email or '' }}</span>
    <span>{{ generated_on }}</span>
  </div>
</section>

{# ================= 회사 소개 ================= #}
<section class="page">
  <h2 class="section-title">회사 소개 <small>About Us</small></h2>
  {% if greeting and greeting.text %}
  <div class="greeting">
    <div class="g-title">GREETING</div>
    {% for para in greeting.text %}<p>{{ para }}</p>{% endfor %}
    {% if greeting.signer %}<div class="signer">{{ greeting.signer }}</div>{% endif %}
  </div>
  {% endif %}
  {% if about %}
  <div class="lead">
    {% for para in about %}<p>{{ para }}</p>{% endfor %}
  </div>
  {% endif %}
  {% if values_on_about_page %}
  {{ values_block(values, true) }}
  {% if strategies %}{{ strategies_block(strategies) }}{% endif %}
  {% endif %}

  {% if stats %}
  <div class="stats">
    {% for s in stats %}
    <div class="stat"><div class="value">{{ s.value }}</div><div class="label">{{ s.label }}</div></div>
    {% endfor %}
  </div>
  {% endif %}

  {% if mission or vision %}
  <div class="mv">
    {% if mission %}<div class="box"><div class="kicker">MISSION</div><div class="text">{{ mission }}</div></div>{% endif %}
    {% if vision %}<div class="box alt"><div class="kicker">VISION</div><div class="text">{{ vision }}</div></div>{% endif %}
  </div>
  {% endif %}

  {% if history_on_about_page %}
  {{ history_block(history, true) }}
  {% endif %}

  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>

{# ================= 핵심 가치 / 연혁 ================= #}
{% if (values and not values_on_about_page) or (history and not history_on_about_page) %}
<section class="page">
  {% if values and not values_on_about_page %}
  {{ values_block(values, false) }}
  {% if strategies %}{{ strategies_block(strategies) }}{% endif %}
  {% endif %}

  {% if history and not history_on_about_page %}
  {{ history_block(history, values) }}
  {% endif %}
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endif %}

{# ================= 무엇이 다른가 / 교육 3축 ================= #}
{% if comparison or program_axes %}
<section class="page">
  {% if comparison %}
  <h2 class="section-title">{{ comparison.title or c.name ~ ', 무엇이 다른가?' }} <small>Why Different</small></h2>
  {% if comparison.quote %}<div class="cmp-quote">{{ comparison.quote|emph }}</div>{% endif %}
  {% if comparison.before or comparison.after %}
  <div class="cmp-cols">
    <div class="cmp-col"><h4>{{ comparison.before_title or '기존 교육의 한계' }}</h4><ul>{% for x in comparison.before %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="cmp-col after"><h4>{{ comparison.after_title or c.name }}</h4><ul>{% for x in comparison.after %}<li>{{ x }}</li>{% endfor %}</ul></div>
  </div>
  {% endif %}
  {% if comparison.goal %}<div class="cmp-goal"><div class="k">교육의 목표</div><div class="v">{{ comparison.goal }}</div></div>{% endif %}
  {% endif %}

  {% if program_axes %}
  <h2 class="section-title" {% if comparison %}style="margin-top:10mm"{% endif %}>교육 프로그램 <small>Programs</small></h2>
  <div class="axes">
    {% for a in program_axes %}
    <div class="axis"><div class="lbl">{{ a.title }}</div><div class="txt">{{ a.text|emph }}</div></div>
    {% endfor %}
  </div>
  {% if program_axes_note %}<div class="axes-note">“ {{ program_axes_note }} ”</div>{% endif %}
  {% endif %}
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endif %}

{# ================= 프로그램 상세 (sections 가 있는 프로그램은 한 페이지씩) ================= #}
{% for p in detail_programs %}
<section class="page">
  <h2 class="section-title">{{ p.title }} {% if p.en %}<small>{{ p.en }}</small>{% endif %}</h2>
  {% if p.target %}<div class="pd-target">활용 대상 &nbsp;|&nbsp; {{ p.target }}</div>{% endif %}
  {% if p.summary %}<div class="pd-intro">{{ p.summary|emph }}</div>{% endif %}
  <div class="pd-sections{{ ' spread' if not p.photos else '' }}">
    {% for sec in p.sections %}
    <div class="pd-section">
      <h4><span class="n">{{ loop.index }}.</span>{{ sec.title }}</h4>
      {% if sec.subtitle %}<div class="sub">{{ sec.subtitle }}</div>{% endif %}
      <ul>{% for it in sec['items'] %}<li>{{ it }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
  {% if p.photos %}
  {% set cols = 3 if p.photos|length % 3 == 0 else 2 %}
  <div class="pd-photos" style="--cols:{{ cols }};--ph-h:{{ '42mm' if cols == 3 else '52mm' }}">
    {% for ph in p.photos %}
      {% if ph.src %}<img src="{{ ph.src }}" alt="{{ p.title }} 사진">
      {% else %}<div class="photo-slot"><div class="ps-icon">▨</div><div class="ps-label">사진 자리</div><div class="ps-file">{{ ph.path }}</div></div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endfor %}

{# ================= 프로그램 카드 / 강점 ================= #}
{% if simple_programs or strengths %}
<section class="page">
  {% if simple_programs %}
  <h2 class="section-title">{{ programs_heading.title if programs_heading and programs_heading.title else '교육 프로그램' }} <small>{{ programs_heading.en if programs_heading and programs_heading.en else 'Programs & Services' }}</small></h2>
  {% if programs_heading and programs_heading.subtitle %}<p class="lead" style="margin-bottom:5mm">{{ programs_heading.subtitle }}</p>{% endif %}
  <div class="programs">
    {% for p in simple_programs %}
    <div class="program">
      <h3>{{ p.title }}</h3>
      {% if p.summary %}<div class="summary">{{ p.summary }}</div>{% endif %}
      <div class="meta">
        {% if p.target %}<span>대상 <b>{{ p.target }}</b></span>{% endif %}
        {% if p.duration %}<span>시간 <b>{{ p.duration }}</b></span>{% endif %}
      </div>
      {% if p.features %}<ul>{% for f in p.features %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if strengths and not strengths_on_last_page %}
  {{ strengths_block(strengths, simple_programs) }}
  {% endif %}
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endif %}

{# ================= 강사 소개 =================
   3명 이상이면 한 페이지에 모아 보여주는 카드 그리드, 2명 이하면 상세 배치.
   instructors_layout 에 "grid" 또는 "detail" 을 적어 직접 고를 수도 있습니다. #}
{% set ins_grid = instructors_layout == 'grid' or (instructors_layout != 'detail' and instructors|length > 2) %}
{% if instructors and ins_grid %}
{% for chunk in instructors|batch(6) %}
<section class="page">
  <h2 class="section-title">{{ instructors_heading or '분야별 대표 강사' }} <small>Our Instructors</small></h2>
  {% if instructors_subtitle and loop.first %}<p class="lead" style="font-size:10.5pt;margin:-3mm 0 5mm">{{ instructors_subtitle }}</p>{% endif %}
  {% set has_photo = chunk|selectattr('photo')|list or chunk|selectattr('photo_slot.missing')|list %}
  {% set ins_cols = chunk|length if chunk|length <= 4 else 3 %}
  <div class="ins-grid{{ ' few' if chunk|length <= 4 else '' }}{{ '' if has_photo else ' nophoto' }}" style="--ins-cols:{{ ins_cols }};--ins-ph:{{ {1:'70mm', 2:'62mm', 3:'32mm', 4:'58mm'}.get(ins_cols, '32mm') }}">
    {% for i in chunk %}
    <div class="ins-card">
      {% if i.photo %}<img class="ph" src="{{ i.photo }}" alt="{{ i.name }}">
      {% elif i.photo_slot and i.photo_slot.missing %}<div class="photo-slot ph-slot"><div class="ps-icon">▨</div><div class="ps-label">사진 자리</div><div class="ps-file">{{ i.photo_slot.path }}</div></div>
      {% elif not has_photo %}<div class="initial">{{ i.name[:1] if i.name else '·' }}</div>
      {% elif i.name %}<div class="ph-avatar">{{ i.name[:1] }}</div>
      {% else %}<div class="ph-avatar">▨</div>{% endif %}
      <div class="body">
        {% if i.field %}<span class="field">{{ i.field }}</span>{% endif %}
        <div class="nm">{% if i.name %}{{ i.name }}{% else %}<span class="todo">성함</span>{% endif %}</div>
        {% if i.title %}<div class="rl">{{ i.title }}</div>{% endif %}
        {% if i.quote %}<div class="qt">“{{ i.quote }}”</div>{% endif %}
        {% if i.specialties %}<div class="tg">{% for t in i.specialties[:3] %}<span>{{ t }}</span>{% endfor %}</div>{% endif %}
        {% if i.career %}<div class="one-line" style="margin-top:2mm"><span class="lbl">경력</span>{{ i.career|join(' · ') }}</div>{% endif %}
        {% if i.certifications %}<div class="one-line clamp1"><span class="lbl">자격</span>{{ i.certifications|join(' · ') }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endfor %}
{% endif %}

{% if instructors and not ins_grid %}
{% for chunk in instructors|batch(2) %}
<section class="page">
  <h2 class="section-title">강사 소개 <small>Our Instructors</small></h2>
  {% for i in chunk %}
  <div class="instructor">
    {% if i.photo %}<img class="photo" src="{{ i.photo }}" alt="{{ i.name }}">
    {% elif i.photo_slot and i.photo_slot.missing %}<div class="photo-slot"><div class="ps-icon">▨</div><div class="ps-label">사진 자리</div><div class="ps-file">{{ i.photo_slot.path }}</div></div>
    {% else %}<div class="avatar">{{ i.name[:1] }}</div>{% endif %}
    <div>
      <h3>{{ i.name }}</h3>
      {% if i.title %}<div class="role">{{ i.title }}</div>{% endif %}
      {% if i.specialties %}<div class="tags">{% for t in i.specialties %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
      {% if i.quote %}<div class="quote">“{{ i.quote }}”</div>{% endif %}
      {% if i.bio %}<div class="bio">{% for para in i.bio %}<p>{{ para }}</p>{% endfor %}</div>{% endif %}
      <div class="cols">
        {% if i.career %}<div><h4>주요 경력</h4><ul>{% for x in i.career %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
        {% if i.education or i.certifications %}
        <div>
          {% if i.education %}<h4>학력</h4><ul>{% for x in i.education %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
          {% if i.certifications %}<h4 style="margin-top:2mm">자격</h4><ul>{% for x in i.certifications %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endfor %}
{% endif %}

{# ================= 고객사 / 후기 / 마무리 ================= #}
{% set back_cover = not clients and not testimonials and not strengths_on_last_page %}
{% if back_cover %}
<section class="page backcover">
  {% if c.logo_white or c.logo %}<img class="bc-logo" src="{{ c.logo_white or c.logo }}" alt="{{ c.name }} 로고">{% else %}<div class="bc-name">{{ c.name }}</div>{% endif %}
  {% if closing and closing.headline %}<h2>{{ closing.headline }}</h2>{% endif %}
  {% if closing and closing.message %}<div class="bc-msg">{{ closing.message }}</div>{% endif %}
  <div class="accent-bar"></div>
  <div class="bc-contact">
    {% if c.ceo %}<div><div class="k">대표</div><div class="v">{{ c.ceo }}</div></div>{% endif %}
    {% if c.founded %}<div><div class="k">설립</div><div class="v">{{ c.founded }}</div></div>{% endif %}
    {% if c.phone %}<div><div class="k">전화</div><div class="v">{{ c.phone }}</div></div>{% endif %}
    {% if c.email %}<div><div class="k">이메일</div><div class="v">{{ c.email }}</div></div>{% endif %}
    {% if c.website %}<div><div class="k">웹사이트</div><div class="v">{{ c.website }}</div></div>{% endif %}
    {% if c.address %}<div><div class="k">주소</div><div class="v">{{ c.address }}</div></div>{% endif %}
    {% if c.business_number %}<div><div class="k">사업자등록번호</div><div class="v">{{ c.business_number }}</div></div>{% endif %}
  </div>
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% else %}
<section class="page">
  {% if strengths_on_last_page %}
  {{ strengths_block(strengths, false) }}
  {% endif %}
  {% if clients %}
  <h2 class="section-title" {% if strengths_on_last_page %}style="margin-top:10mm"{% endif %}>주요 고객사 <small>Clients &amp; Partners</small></h2>
  <div class="clients">{% for cl in clients %}<div class="client">{{ cl }}</div>{% endfor %}</div>
  {% endif %}

  {% if testimonials %}
  <div class="testimonials">
    {% for t in testimonials %}
    <div class="testimonial"><div class="q">“{{ t.quote }}”</div>{% if t.author %}<div class="a">— {{ t.author }}</div>{% endif %}</div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="closing-block">
  {% if closing %}
  <div class="closing">
    {% if closing.headline %}<h2>{{ closing.headline }}</h2>{% endif %}
    {% if closing.message %}<p>{{ closing.message }}</p>{% endif %}
  </div>
  {% endif %}

  {% if c.logo %}<img class="closing-logo" src="{{ c.logo }}" alt="{{ c.name }} 로고">{% endif %}
  <div class="contact">
    {% if c.founded %}<div><div class="k">설립</div><div class="v">{{ c.founded }}</div></div>{% endif %}
    {% if c.ceo %}<div><div class="k">대표</div><div class="v">{{ c.ceo }}</div></div>{% endif %}
    {% if c.business_number %}<div><div class="k">사업자등록번호</div><div class="v">{{ c.business_number }}</div></div>{% endif %}
    {% if c.phone %}<div><div class="k">전화</div><div class="v">{{ c.phone }}</div></div>{% endif %}
    {% if c.email %}<div><div class="k">이메일</div><div class="v">{{ c.email }}</div></div>{% endif %}
    {% if c.website %}<div><div class="k">웹사이트</div><div class="v">{{ c.website }}</div></div>{% endif %}
    {% if c.address %}<div><div class="k">주소</div><div class="v">{{ c.address }}</div></div>{% endif %}
  </div>
  </div>
  <div class="page-footer"><span>{{ c.name }}</span><span>회사소개서</span></div>
</section>
{% endif %}

</body>
</html>
